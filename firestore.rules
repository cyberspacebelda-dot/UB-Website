rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasOfficeProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/office_staff_auth/$(request.auth.uid));
    }

    function officeProfile() {
      return get(/databases/$(database)/documents/office_staff_auth/$(request.auth.uid)).data;
    }

    function validOfficeIdentity() {
      return hasOfficeProfile() &&
        officeProfile().uid == request.auth.uid &&
        officeProfile().active == true &&
        request.auth.token.phone_number is string &&
        officeProfile().phoneE164 == request.auth.token.phone_number &&
        officeProfile().displayName is string &&
        officeProfile().displayName.size() > 0;
    }

    function isSuperAdmin() {
      return validOfficeIdentity() &&
        officeProfile().staffRole == 'SUPER_ADMIN' &&
        officeProfile().officeCategory == 'SUPER_ADMIN';
    }

    // Compatibility alias: administrator-only operations mean SUPER_ADMIN only.
    function isAdmin() {
      return isSuperAdmin();
    }

    function isBillingStaff() {
      return validOfficeIdentity() &&
        officeProfile().staffRole in ['STAFF_SONALI', 'STAFF_KOUSHIK'] &&
        officeProfile().officeCategory == 'BILLING_STAFF';
    }

    function isDeliveryStaff() {
      return validOfficeIdentity() &&
        officeProfile().staffRole == 'STAFF_JEET' &&
        officeProfile().officeCategory == 'DELIVERY_STAFF';
    }

    function isOfficeViewer() {
      return validOfficeIdentity() &&
        officeProfile().staffRole in ['ADMIN_GOPAL', 'ADMIN_MILAN'] &&
        officeProfile().officeCategory == 'BILLING_PRODUCTION_VIEWER';
    }

    function isApprovedStaff() {
      return isBillingStaff() || isDeliveryStaff();
    }

    function isApprovedOfficeUser() {
      return isSuperAdmin() || isOfficeViewer() || isApprovedStaff();
    }

    function canEditMedicine() {
      return isSuperAdmin() || isBillingStaff();
    }

    function validMedicine(data) {
      return data.slNo is int && data.slNo >= 0 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.codeName is string && data.codeName.size() > 0 && data.codeName.size() <= 100 &&
        data.quantityNetContent is string && data.quantityNetContent.size() <= 100 &&
        data.mrpPrice is number && data.mrpPrice >= 0 &&
        data.hmPrice is number && data.hmPrice >= 0 &&
        data.patientPrice is number && data.patientPrice >= 0 &&
        data.stockQuantity is int && data.stockQuantity >= 0 &&
        data.lowStockThreshold is int && data.lowStockThreshold >= 0 &&
        data.status in ['IN_STOCK', 'AVAILABLE', 'LOW_STOCK', 'OUT_OF_STOCK'] &&
        data.updatedAt is timestamp && data.updatedAt <= request.time &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
        (!('branchStock' in data) || data.branchStock is map) &&
        (!('batchNumber' in data) || (data.batchNumber is string && data.batchNumber.size() <= 100)) &&
        (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 50)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    function validInventoryLog(data) {
      return data.medicineId is string && data.medicineId.size() > 0 && data.medicineId.size() <= 100 &&
        data.medicineName is string && data.medicineName.size() > 0 && data.medicineName.size() <= 200 &&
        data.action is string &&
        data.action in ['STOCK_IN', 'STOCK_OUT', 'PRICE_UPDATE', 'ENTRY_EDIT', 'ENTRY_CREATE', 'ENTRY_DELETE', 'MANUAL_STOCK_ENTRY', 'STOCK_RESET', 'QUICK_ADJUST'] &&
        data.createdByUid == request.auth.uid &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // Authorization profiles are provisioned only by a trusted server/admin process.
    match /office_staff_auth/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid && validOfficeIdentity()) || isSuperAdmin();
      allow list, create, update, delete: if false;
    }

    // Medicine catalogue/stock is readable by approved office users.
    // Only Super Admin and approved Billing Staff may change medicine records.
    match /medicines/{medicineId} {
      allow get, list: if isApprovedOfficeUser();
      allow create: if canEditMedicine() && validMedicine(request.resource.data);
      allow update: if canEditMedicine() &&
        (!('createdAt' in resource.data) ||
         request.resource.data.createdAt == resource.data.createdAt) &&
        validMedicine(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Inventory audit trail is readable by approved office users and append-only.
    // Delivery/Billing staff may append; view-only admins cannot write.
    match /inventory_logs/{logId} {
      allow get, list: if isApprovedOfficeUser();
      allow create: if (isSuperAdmin() || isApprovedStaff()) &&
        validInventoryLog(request.resource.data);
      allow update, delete: if false;
    }

    // Limit each configuration document to its own role policy.
    match /commission_config/{configId} {
      allow get, list: if
        (configId == 'medicine_price_list_2026' && isApprovedOfficeUser()) ||
        (configId == 'incentive_rules_v2' && isSuperAdmin());

      allow create, update: if
        (configId == 'medicine_price_list_2026' && canEditMedicine()) ||
        (configId == 'incentive_rules_v2' && isSuperAdmin());

      allow delete: if isSuperAdmin();
    }

    // HM identity and business records remain closed until UID mapping and
    // collection-specific role rules are implemented and emulator-tested.
    match /health_mitras/{documentId} {
      allow read, write: if false;
    }
    match /bills/{documentId} {
      allow read, write: if false;
    }
    match /returns/{documentId} {
      allow read, write: if false;
    }
    match /ledger/{documentId} {
      allow read, write: if false;
    }
    match /admins/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}